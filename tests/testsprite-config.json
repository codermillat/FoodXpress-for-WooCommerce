{
  "project": {
    "name": "FoodXpress for WooCommerce",
    "version": "1.1.0",
    "type": "wordpress-plugin"
  },
  "wordpress": {
    "version": "6.7",
    "woocommerce_version": "9.4",
    "php_version": "7.4+",
    "test_url": "http://localhost:8080",
    "admin_credentials": {
      "username": "millat",
      "password": "millat"
    },
    "note": "Update test_url to your WordPress site URL (can be remote/staging site)"
  },
  "test_suites": [
    {
      "name": "Plugin Activation",
      "description": "Test plugin installation and activation",
      "tests": [
        {
          "name": "Plugin activates successfully",
          "steps": [
            "Navigate to WordPress admin plugins page",
            "Activate FoodXpress for WooCommerce plugin",
            "Verify no errors displayed",
            "Verify plugin appears in active plugins list"
          ]
        },
        {
          "name": "WooCommerce dependency check",
          "steps": [
            "Deactivate WooCommerce",
            "Verify FoodXpress shows dependency notice",
            "Reactivate WooCommerce",
            "Verify notice disappears"
          ]
        },
        {
          "name": "Custom order statuses registered",
          "steps": [
            "Check order statuses in WooCommerce",
            "Verify 'In Kitchen' status exists",
            "Verify 'Assigned' status exists",
            "Verify 'Picked Up' status exists"
          ]
        },
        {
          "name": "Delivery boy role created",
          "steps": [
            "Check user roles in WordPress",
            "Verify 'Delivery Boy' role exists",
            "Verify role has correct capabilities"
          ]
        }
      ]
    },
    {
      "name": "Order Management",
      "description": "Test order status flow and management",
      "tests": [
        {
          "name": "Order status progression",
          "steps": [
            "Create a test order",
            "Change status to 'In Kitchen'",
            "Verify email notification sent",
            "Assign delivery boy to order",
            "Change status to 'Assigned'",
            "Verify assignment email sent",
            "Change status to 'Picked Up'",
            "Verify pickup email sent",
            "Change status to 'Delivered'",
            "Verify order completion"
          ]
        },
        {
          "name": "Order assignment functionality",
          "steps": [
            "Create delivery boy user",
            "Create test order",
            "Assign delivery boy from admin",
            "Verify order appears in delivery dashboard",
            "Verify only assigned orders visible to delivery boy"
          ]
        }
      ]
    },
    {
      "name": "Delivery Dashboard",
      "description": "Test delivery boy dashboard functionality",
      "tests": [
        {
          "name": "Dashboard access control",
          "steps": [
            "Login as delivery boy",
            "Navigate to /delivery-dashboard/",
            "Verify dashboard loads",
            "Verify only assigned orders visible",
            "Verify cannot access other orders"
          ]
        },
        {
          "name": "Order status updates",
          "steps": [
            "Login as delivery boy",
            "View assigned order",
            "Update status to 'Picked Up'",
            "Verify status change successful",
            "Update status to 'Delivered'",
            "Verify order marked as delivered"
          ]
        }
      ]
    },
    {
      "name": "Checkout & Shipping",
      "description": "Test checkout process and shipping method",
      "tests": [
        {
          "name": "Shipping method appears",
          "steps": [
            "Add product to cart",
            "Go to checkout",
            "Verify FoodXpress shipping method available",
            "Select shipping method",
            "Verify delivery fee calculated"
          ]
        },
        {
          "name": "Google Maps integration",
          "steps": [
            "Go to checkout page",
            "Verify map displays",
            "Select delivery location on map",
            "Verify address populated",
            "Verify distance calculated",
            "Verify delivery fee updates"
          ]
        },
        {
          "name": "Delivery radius validation",
          "steps": [
            "Set delivery location outside radius",
            "Attempt to place order",
            "Verify error message displayed",
            "Select location within radius",
            "Verify order can be placed"
          ]
        }
      ]
    },
    {
      "name": "Shortcodes",
      "description": "Test plugin shortcodes",
      "tests": [
        {
          "name": "Order tracking shortcode",
          "steps": [
            "Create page with [fxw_track_order] shortcode",
            "View page as customer",
            "Enter order number",
            "Verify order details displayed",
            "Verify status information shown"
          ]
        },
        {
          "name": "Reorder shortcode",
          "steps": [
            "Create page with [fxw_reorder] shortcode",
            "View page as logged-in customer",
            "Verify previous orders listed",
            "Test reorder functionality"
          ]
        }
      ]
    },
    {
      "name": "Settings & Configuration",
      "description": "Test plugin settings page",
      "tests": [
        {
          "name": "Settings page access",
          "steps": [
            "Login as admin",
            "Navigate to WooCommerce → Settings → FoodXpress",
            "Verify settings page loads",
            "Verify all settings fields present"
          ]
        },
        {
          "name": "Settings save functionality",
          "steps": [
            "Update restaurant address",
            "Update delivery radius",
            "Update base delivery fee",
            "Save settings",
            "Verify settings saved",
            "Verify changes reflected in checkout"
          ]
        }
      ]
    },
    {
      "name": "Email Notifications",
      "description": "Test email notification system",
      "tests": [
        {
          "name": "Email templates exist",
          "steps": [
            "Navigate to WooCommerce → Settings → Emails",
            "Verify 'Order In Kitchen' email exists",
            "Verify 'Driver Assigned' email exists",
            "Verify 'Order Picked Up' email exists"
          ]
        },
        {
          "name": "Email sending",
          "steps": [
            "Create test order",
            "Change order status",
            "Verify email sent to customer",
            "Verify email content correct"
          ]
        }
      ]
    },
    {
      "name": "Security",
      "description": "Test security features",
      "tests": [
        {
          "name": "Nonce verification",
          "steps": [
            "Test AJAX endpoints without nonce",
            "Verify requests rejected",
            "Test with valid nonce",
            "Verify requests accepted"
          ]
        },
        {
          "name": "Capability checks",
          "steps": [
            "Login as subscriber",
            "Attempt to access admin functions",
            "Verify access denied",
            "Login as delivery boy",
            "Verify only allowed functions accessible"
          ]
        },
        {
          "name": "ABSPATH checks",
          "steps": [
            "Verify all PHP files have ABSPATH check",
            "Test direct file access",
            "Verify access blocked"
          ]
        }
      ]
    }
  ],
  "environment": {
    "browser": "chromium",
    "headless": true,
    "screenshot_on_failure": true,
    "timeout": 30000
  },
  "reporting": {
    "format": "json",
    "include_screenshots": true,
    "notify_on_failure": true
  }
}

