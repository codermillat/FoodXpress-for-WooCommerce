{
  "intelephense.files.maxSize": 5000000,
  "intelephense.stubs": [
    "apache",
    "bcmath",
    "bz2",
    "Core",
    "curl",
    "date",
    "dom",
    "fileinfo",
    "filter",
    "gd",
    "hash",
    "iconv",
    "intl",
    "json",
    "libxml",
    "mbstring",
    "mcrypt",
    "mysql",
    "mysqli",
    "openssl",
    "pcntl",
    "pcre",
    "PDO",
    "pdo_mysql",
    "Phar",
    "readline",
    "Reflection",
    "regex",
    "session",
    "SimpleXML",
    "SPL",
    "standard",
    "tokenizer",
    "wordpress",
    "xml",
    "xmlreader",
    "xmlwriter",
    "zip",
    "zlib"
  ],
  "intelephense.environment.phpVersion": "7.4",
  "intelephense.diagnostics.undefinedFunctions": false,
  "[php]": {
    "editor.defaultFormatter": "bmewburn.vscode-intelephense-client",
    "editor.formatOnSave": false
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "files.associations": {
    "*.php": "php"
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/vendor": true,
    "**/.DS_Store": true
  }
}
