{
  "tech_stack": [
    "PHP",
    "WordPress",
    "WooCommerce",
    "MySQL",
    "JavaScript",
    "jQuery",
    "Google Maps API"
  ],
  "features": [
    {
      "name": "Get Restaurant Location",
      "description": "AJAX endpoint to retrieve restaurant coordinates for map centering and delivery zone drawing",
      "files": [
        "includes/class-fxw-checkout.php"
      ],
      "api_doc": {
        "openapi": "3.0.0",
        "info": {
          "title": "Get Restaurant Location API",
          "version": "1.1.0"
        },
        "paths": {
          "/wp-admin/admin-ajax.php": {
            "post": {
              "summary": "Get restaurant location coordinates",
              "operationId": "getRestaurantLocation",
              "requestBody": {
                "required": true,
                "content": {
                  "application/x-www-form-urlencoded": {
                    "schema": {
                      "type": "object",
                      "required": ["action", "nonce"],
                      "properties": {
                        "action": {
                          "type": "string",
                          "example": "fxw_get_restaurant_location"
                        },
                        "nonce": {
                          "type": "string",
                          "description": "WordPress nonce for security"
                        }
                      }
                    }
                  }
                }
              },
              "responses": {
                "200": {
                  "description": "Success",
                  "content": {
                    "application/json": {
                      "schema": {
                        "type": "object",
                        "properties": {
                          "success": {
                            "type": "boolean"
                          },
                          "data": {
                            "type": "object",
                            "properties": {
                              "lat": {
                                "type": "number"
                              },
                              "lng": {
                                "type": "number"
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "name": "Update Customer Location",
      "description": "AJAX endpoint to update customer delivery location and calculate delivery fee",
      "files": [
        "includes/class-fxw-checkout.php"
      ],
      "api_doc": {
        "openapi": "3.0.0",
        "info": {
          "title": "Update Customer Location API",
          "version": "1.1.0"
        },
        "paths": {
          "/wp-admin/admin-ajax.php": {
            "post": {
              "summary": "Update customer delivery location",
              "operationId": "updateCustomerLocation",
              "requestBody": {
                "required": true,
                "content": {
                  "application/x-www-form-urlencoded": {
                    "schema": {
                      "type": "object",
                      "required": ["action", "nonce", "lat", "lng"],
                      "properties": {
                        "action": {
                          "type": "string",
                          "example": "fxw_update_customer_location"
                        },
                        "nonce": {
                          "type": "string"
                        },
                        "lat": {
                          "type": "number",
                          "description": "Latitude of delivery location"
                        },
                        "lng": {
                          "type": "number",
                          "description": "Longitude of delivery location"
                        },
                        "address": {
                          "type": "string",
                          "description": "Formatted address"
                        }
                      }
                    }
                  }
                }
              },
              "responses": {
                "200": {
                  "description": "Success",
                  "content": {
                    "application/json": {
                      "schema": {
                        "type": "object",
                        "properties": {
                          "success": {
                            "type": "boolean"
                          },
                          "data": {
                            "type": "object",
                            "properties": {
                              "distance": {
                                "type": "number"
                              },
                              "fee": {
                                "type": "number"
                              },
                              "eta": {
                                "type": "string"
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "name": "AJAX Assign Delivery",
      "description": "AJAX endpoint for admin to assign delivery personnel to orders",
      "files": [
        "includes/class-fxw-dashboard.php"
      ],
      "api_doc": {
        "openapi": "3.0.0",
        "info": {
          "title": "Assign Delivery API",
          "version": "1.1.0"
        },
        "paths": {
          "/wp-admin/admin-ajax.php": {
            "post": {
              "summary": "Assign delivery boy to order",
              "operationId": "ajaxAssignDelivery",
              "requestBody": {
                "required": true,
                "content": {
                  "application/x-www-form-urlencoded": {
                    "schema": {
                      "type": "object",
                      "required": ["action", "nonce", "order_id", "delivery_boy_id"],
                      "properties": {
                        "action": {
                          "type": "string",
                          "example": "fxw_ajax_assign_delivery"
                        },
                        "nonce": {
                          "type": "string"
                        },
                        "order_id": {
                          "type": "integer",
                          "description": "WooCommerce order ID"
                        },
                        "delivery_boy_id": {
                          "type": "integer",
                          "description": "User ID of delivery personnel"
                        }
                      }
                    }
                  }
                }
              },
              "responses": {
                "200": {
                  "description": "Success"
                }
              }
            }
          }
        }
      }
    },
    {
      "name": "AJAX Update Order Status",
      "description": "AJAX endpoint to update order status (In Kitchen, Assigned, Picked Up, Delivered)",
      "files": [
        "includes/class-fxw-dashboard.php",
        "includes/class-fxw-delivery-boy-view.php"
      ],
      "api_doc": {
        "openapi": "3.0.0",
        "info": {
          "title": "Update Order Status API",
          "version": "1.1.0"
        },
        "paths": {
          "/wp-admin/admin-ajax.php": {
            "post": {
              "summary": "Update order status",
              "operationId": "ajaxUpdateStatus",
              "requestBody": {
                "required": true,
                "content": {
                  "application/x-www-form-urlencoded": {
                    "schema": {
                      "type": "object",
                      "required": ["action", "nonce", "order_id", "status"],
                      "properties": {
                        "action": {
                          "type": "string",
                          "example": "fxw_ajax_update_status"
                        },
                        "nonce": {
                          "type": "string"
                        },
                        "order_id": {
                          "type": "integer"
                        },
                        "status": {
                          "type": "string",
                          "enum": ["fxw-in-kitchen", "fxw-assigned", "fxw-picked-up", "completed"],
                          "description": "New order status"
                        }
                      }
                    }
                  }
                }
              },
              "responses": {
                "200": {
                  "description": "Success"
                }
              }
            }
          }
        }
      }
    },
    {
      "name": "Print Receipt",
      "description": "AJAX endpoint to generate and print order receipt",
      "files": [
        "includes/class-fxw-shortcodes.php"
      ],
      "api_doc": {
        "openapi": "3.0.0",
        "info": {
          "title": "Print Receipt API",
          "version": "1.1.0"
        },
        "paths": {
          "/wp-admin/admin-ajax.php": {
            "post": {
              "summary": "Generate receipt for order",
              "operationId": "printReceipt",
              "requestBody": {
                "required": true,
                "content": {
                  "application/x-www-form-urlencoded": {
                    "schema": {
                      "type": "object",
                      "required": ["action", "nonce", "order_id"],
                      "properties": {
                        "action": {
                          "type": "string",
                          "example": "fxw_print_receipt"
                        },
                        "nonce": {
                          "type": "string"
                        },
                        "order_id": {
                          "type": "integer"
                        }
                      }
                    }
                  }
                }
              },
              "responses": {
                "200": {
                  "description": "Receipt HTML"
                }
              }
            }
          }
        }
      }
    },
    {
      "name": "Delivery Dashboard",
      "description": "Custom WordPress page for delivery personnel to view and manage assigned orders",
      "files": [
        "includes/class-fxw-delivery-boy-view.php",
        "templates/delivery-dashboard-template.php"
      ],
      "api_doc": {
        "openapi": "3.0.0",
        "info": {
          "title": "Delivery Dashboard",
          "version": "1.1.0"
        },
        "paths": {
          "/delivery-dashboard/": {
            "get": {
              "summary": "Delivery dashboard page",
              "operationId": "deliveryDashboard",
              "responses": {
                "200": {
                  "description": "Dashboard page HTML"
                },
                "302": {
                  "description": "Redirect if not logged in or lacks permissions"
                }
              }
            }
          }
        }
      }
    },
    {
      "name": "Order Tracking Shortcode",
      "description": "Frontend shortcode [fxw_track_order] for customers to track orders",
      "files": [
        "includes/class-fxw-shortcodes.php"
      ],
      "api_doc": {
        "openapi": "3.0.0",
        "info": {
          "title": "Order Tracking",
          "version": "1.1.0"
        },
        "paths": {
          "/": {
            "get": {
              "summary": "Order tracking page with shortcode",
              "operationId": "trackOrder",
              "parameters": [
                {
                  "name": "order_number",
                  "in": "query",
                  "schema": {
                    "type": "string"
                  }
                }
              ],
              "responses": {
                "200": {
                  "description": "Order tracking page"
                }
              }
            }
          }
        }
      }
    },
    {
      "name": "WooCommerce Shipping Method",
      "description": "Custom WooCommerce shipping method for FoodXpress delivery with distance-based pricing",
      "files": [
        "includes/class-fxw-shipping-method.php"
      ],
      "api_doc": {
        "openapi": "3.0.0",
        "info": {
          "title": "FoodXpress Shipping Method",
          "version": "1.1.0"
        },
        "paths": {
          "/wp-json/wc/v3/shipping/zones/{id}/methods": {
            "get": {
              "summary": "Get shipping methods",
              "operationId": "getShippingMethods"
            }
          }
        }
      }
    },
    {
      "name": "Plugin Settings",
      "description": "WooCommerce settings page for FoodXpress configuration",
      "files": [
        "includes/class-fxw-settings.php"
      ],
      "api_doc": {
        "openapi": "3.0.0",
        "info": {
          "title": "FoodXpress Settings",
          "version": "1.1.0"
        },
        "paths": {
          "/wp-admin/admin.php": {
            "get": {
              "summary": "Settings page",
              "operationId": "getSettings",
              "parameters": [
                {
                  "name": "page",
                  "in": "query",
                  "schema": {
                    "type": "string",
                    "default": "wc-settings"
                  }
                },
                {
                  "name": "tab",
                  "in": "query",
                  "schema": {
                    "type": "string",
                    "default": "foodxpress"
                  }
                }
              ]
            }
          }
        }
      }
    }
  ]
}
